<?xml version="1.0" encoding="utf-8"?>
<!-- Declares the .NET Framework 4.8 target so the runtime uses modern
     TLS defaults (strong crypto). A csc-built exe without this config
     falls back to legacy TLS and modern hosts (e.g. NASA) refuse the
     handshake. Keep this file next to NasaApod.exe. -->
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <runtime>
    <AppContextSwitchOverrides value="Switch.System.Net.DontEnableSchUseStrongCrypto=false" />
  </runtime>
</configuration>
